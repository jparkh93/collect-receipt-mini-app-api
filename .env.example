# DB (PostgreSQL via Supabase)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Gemini AI
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# JWT Secret (미니앱 API 서버 전용)
MINI_APP_JWT_SECRET=change-me-in-production

# Toss OAuth decryption
TOSS_DECRYPT_KEY=base64-encoded-aes-key
TOSS_DECRYPT_AAD=TOSS

# Toss mTLS client certificates (base64-encoded PEM files)
# Generate with: base64 -i cert.crt | tr -d '\n'
TOSS_MTLS_CERT=base64-encoded-public-cert
TOSS_MTLS_KEY=base64-encoded-private-key
