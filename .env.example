# DB
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@localhost:5432/dbname"

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Gemini AI
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# JWT Secret (미니앱 API 서버 전용)
MINI_APP_JWT_SECRET=dev-mini-app-secret-change-in-production

# Toss OAuth decryption
TOSS_DECRYPT_KEY=your_toss_decrypt_key_base64
TOSS_DECRYPT_AAD=TOSS
