{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": ".",
  "functions": {
    "api/index.ts": {
      "includeFiles": "node_modules/.prisma/**,node_modules/@prisma/client/**,prisma/schema.prisma",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ]
}
